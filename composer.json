{
    "name": "arghavan/sidebar-manager",
    "description": "پکیج مدیریت سایدبار پنل کاربری برای لاراول - بارگذاری و مدیریت تصویر (لوگو) سایدبار",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "SidebarManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SidebarManager\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SidebarManager\\SidebarManagerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
